with "gtkada";

project template extends "kernelWithParsers.gpr" is 
    PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";

    for Source_Dirs use (PROJECT_DIR & "framework_examples/template", 
                        PROJECT_DIR & "framework_examples/template/util");
    for Main use ("template.adb");

    case kernel.Build is        
        when "Debug" =>
            for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
            for Exec_Dir use PROJECT_DIR;
        when "Release" =>
            for Object_Dir use PROJECT_DIR & "binaries/objects/release";
            for Exec_Dir use PROJECT_DIR;
    end case;

    package Builder is
        Executable := "";
        
        case kernel.Build is
            when "Release" =>
                Executable := "framework_examples/template/template";
            when "Debug" =>
                Executable := "framework_examples/template/template_d";
	    end case;

        for Executable ("template.adb") use Executable;
    end Builder;
end template;



