with "gtkada";

project simulation_interval extends "kernelWithParsers.gpr" is 
    PROJECT_DIR := external("CHEDDAR_DIR") & "/src/";

    for Source_Dirs use (PROJECT_DIR & "framework_examples/simulation_interval", 
                        PROJECT_DIR & "framework_examples/simulation_interval/util" , PROJECT_DIR & "modules/cheddar_cli/util");
    for Main use ("simulation_interval.adb");

    case kernel.Build is        
        when "Debug" =>
            for Object_Dir use PROJECT_DIR & "binaries/objects/debug";
            for Exec_Dir use PROJECT_DIR;
        when "Release" =>
            for Object_Dir use PROJECT_DIR & "binaries/objects/release";
            for Exec_Dir use PROJECT_DIR;
    end case;

    package Builder is
        Executable := "";
        
        case kernel.Build is
            when "Release" =>
                Executable := "framework_examples/simulation_interval/simulation_interval";
            when "Debug" =>
                Executable := "framework_examples/simulation_interval/simulation_interval";
	    end case;

        for Executable ("simulation_interval.adb") use Executable;
    end Builder;
end simulation_interval;



